{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm start:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(npm view *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Skill(agent-browser)",
      "Skill(agent-browser:*)",
      "Bash(agent-browser open *)",
      "Bash(agent-browser wait *)",
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser click *)",
      "Bash(agent-browser screenshot *)",
      "Bash(agent-browser set *)",
      "Bash(agent-browser close *)",
      "Bash(agent-browser fill *)",
      "Bash(agent-browser get *)",
      "Bash(agent-browser hover *)",
      "Bash(agent-browser viewport *)",
      "Bash(agent-browser skills *)",
      "Bash(curl -s -o /dev/null -w * http://localhost:3000/*)",
      "Read(//Users/guilhermebittelbrunn/.claude/**)",
      "Edit(/.claude/skills/new-crud/**)",
      "Bash(pnpm --version)",
      "Bash(tee /tmp/tsc-out.txt)",
      "Bash(git rm *)",
      "Bash(pnpm typecheck *)",
      "Bash(echo \"typecheck exit: $?\")",
      "Bash(pnpm install *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git --no-pager log --oneline -1)",
      "Bash(git --no-pager log --oneline -3)",
      "Bash(git --no-pager diff .claude/settings.json)",
      "Bash(git --no-pager diff --stat)",
      "Bash(git --no-pager diff -- src/app/layout.tsx src/app/robots.ts src/app/sitemap.ts src/shared/seo/metadata.ts)",
      "Bash(git --no-pager diff -- \"src/app/\\(home\\)/page.tsx\" \"src/app/\\(home\\)/components/Home.tsx\" \"src/app/\\(event\\)/\\(private\\)/evento/[slug]/layout.tsx\")",
      "Bash(sips -g pixelWidth -g pixelHeight public/images/shared/qinstante.png)",
      "Bash(git --no-pager diff -- CLAUDE.md .claude/settings.json)",
      "Bash(agent-browser --version)",
      "Bash(curl -s http://localhost:3000/robots.txt)",
      "Bash(curl -s http://localhost:3000/sitemap.xml)",
      "Bash(curl -s http://localhost:3000/manifest.webmanifest)",
      "Bash(curl -s -i http://localhost:3000/manifest.webmanifest)",
      "Bash(agent-browser eval *)",
      "Bash(agent-browser tabs *)",
      "Bash(curl -s http://localhost:3000/)",
      "Bash(agent-browser reload *)",
      "Bash(agent-browser resize *)",
      "Bash(curl -s \"http://localhost:3000/evento/teste-slug\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" \"http://localhost:3000/evento/teste-slug\")",
      "Bash(curl -s -o /dev/null -w \"icon: %{http_code} -> %{redirect_url}\\\\n\" \"http://localhost:3000/images/shared/qinstante.png\")",
      "Bash(curl -s -i \"http://localhost:3000/images/shared/qinstante.png\")",
      "Bash(curl -s -o /dev/null -w \"og-image: %{http_code}\\\\n\" \"http://localhost:3000/_next/static/media/qinstante.ea158c9f.png\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(pkill -f \"next-server\")",
      "Bash(git --no-pager log --oneline -4)",
      "Bash(ls MEMORY.md)",
      "Bash(cat MEMORY.md)",
      "Bash(agent-browser --help)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh\""
          }
        ]
      }
    ]
  }
}
